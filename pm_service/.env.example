# ==================== 敏感配置加密说明 ====================
# 本项目支持对敏感配置进行加密，使用 Fernet 对称加密
#
# 使用方法:
#   1. 生成主密钥: python -m crypto.cli generate-key -o .master.key
#   2. 加密配置值: python -m crypto.cli encrypt "your_password"
#   3. 将加密结果填入配置: MYSQL_PASSWORD=ENC(gAAAAABn...)
#   4. 批量加密: python -m crypto.cli encrypt-env .env
#
# 主密钥配置 (三选一，优先级从高到低):
#   - 环境变量: export APP_MASTER_KEY=your-master-key
#   - 密钥文件: 创建 .master.key 文件（默认路径）
#   - 自定义路径: export APP_MASTER_KEY_FILE=/path/to/key
#
# 支持加密的字段:
#   SECRET_KEY, JWT_SECRET_KEY, MYSQL_PASSWORD, REDIS_PASSWORD,
#   MINIO_PASSWORD, S3_PASSWORD, FTP_PASSWORD, ORACLE_PASSWORD,
#   RABBITMQ_PASSWORD
#
# 注意: 请勿将 .master.key 提交到版本控制系统!

# ==================== 服务器配置 ====================
SERVER_HOST="0.0.0.0"
SERVER_PORT=19999

# ==================== Flask 环境配置 -- 日志配置 ====================
# 服务名称（用于日志标识，覆盖 logging.yaml 中的 service_name）
APP_SERVICE_NAME=AIML_DATASET_SERVICE
# 运行环境：dev/prd（覆盖 logging.yaml 中的 environment）
# 也可使用 FLASK_ENV，会自动映射：development -> dev, production -> prd
FLASK_ENV=dev
# Flask 密钥（支持加密格式）
SECRET_KEY=your-secret-key


# ==================== CORS 配置 ====================
CORS_ORIGINS=*

# ==================== API 文档配置 ====================
API_TITLE=REST API
API_VERSION=v1

# ==================== JWT 配置 ====================
# JWT 密钥（支持加密格式）
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# ==================== 请求配置 ====================
REQUEST_TIMEOUT=30
REQUEST_MAX_RETRIES=3

# ==================== 分页配置 ====================
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100

# ==================== 缓存配置 ====================
CACHE_DEFAULT_TIMEOUT=300

# ==================== 文件上传配置 ====================
MAX_CONTENT_LENGTH=16777216

# ==================== MySQL 配置 ====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=test
MYSQL_USERNAME=root
# MySQL 密码（支持加密格式，如: ENC(gAAAAABn...)）
MYSQL_PASSWORD=

# ==================== MySQL 连接池配置 ====================
SQLPOOL_POOL_SIZE=10
SQLPOOL_MAX_OVERFLOW=20
SQLPOOL_POOL_RECYCLE=3600
SQLPOOL_PRE_PING=true

# ==================== Redis 配置 ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
# Redis 密码（支持加密格式）
REDIS_PASSWORD=
REDIS_REQUIRED=true

# ==================== Redis 连接池配置 ====================
REDIS_POOL_SIZE=10
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_KEEPALIVE=true
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30

# ==================== Celery 配置 ====================
# Broker 地址（消息代理，默认使用 Redis 的 DB 1）
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# Result Backend 地址（结果存储，默认使用 Redis 的 DB 2）
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# 结果过期时间（秒，默认 1 小时）
CELERY_RESULT_EXPIRES=3600
# 任务序列化方式（json/pickle/yaml）
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
# 时区设置
CELERY_TIMEZONE=Asia/Shanghai
CELERY_ENABLE_UTC=false
# 任务超时配置（秒）
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3000
# Worker 配置
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# ==================== RabbitMQ 配置 ====================
# RabbitMQ 服务器地址
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
# RabbitMQ 密码（支持加密格式）
RABBITMQ_PASSWORD=guest
RABBITMQ_VIRTUAL_HOST=/
# 连接超时（秒）
RABBITMQ_CONNECTION_TIMEOUT=10
# 心跳超时（秒）
RABBITMQ_HEARTBEAT=600

# ==================== MinIO 配置 ====================
MINIO_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_USERNAME=minioadmin
# MinIO 密码（支持加密格式）
MINIO_PASSWORD=minioadmin
MINIO_SECURE=false

# ==================== S3 配置 ====================
S3_ENDPOINT=http://127.0.0.1:8080
S3_USERNAME=
# S3 密码（支持加密格式）
S3_PASSWORD=
S3_REGION=us-east-1

# ==================== Elasticsearch 配置 ====================
# Elasticsearch 8.x 配置（搜索引擎）
# 多节点配置用逗号分隔: http://node1:9200,http://node2:9200
ES_HOSTS=http://127.0.0.1:9200
ES_USERNAME=
ES_PASSWORD=
ES_API_KEY=
ES_VERIFY_CERTS=true
ES_CA_CERTS=
ES_TIMEOUT=30
ES_MAX_RETRIES=3
ES_RETRY_ON_TIMEOUT=true

# ==================== MongoDB 配置 ====================
# 连接字符串格式: mongodb://[username:password@]host:port
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=test
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10
MONGO_CONNECT_TIMEOUT=5000
MONGO_SERVER_SELECTION_TIMEOUT=5000

# ==================== InfluxDB 配置 ====================
# InfluxDB 2.x 配置（时序数据库）
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=my-org
INFLUXDB_BUCKET=my-bucket
INFLUXDB_TIMEOUT=10000
INFLUXDB_VERIFY_SSL=true

# ==================== 限流配置 ====================
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=200 per day, 50 per hour
RATELIMIT_STORAGE_URI=memory://

# ==================== FTP 配置 ====================
FTP_ENABLED=false
FTP_HOST=127.0.0.1
FTP_PORT=21
FTP_USERNAME=
# FTP 密码（支持加密格式）
FTP_PASSWORD=
FTP_TIMEOUT=30

# ==================== Oracle 配置 ====================
ORACLE_HOST=127.0.0.1
ORACLE_PORT=1521
ORACLE_USERNAME=
# Oracle 密码（支持加密格式）
ORACLE_PASSWORD=
ORACLE_SERVICE_NAME=
ORACLE_POOL_SIZE=10
ORACLE_MAX_OVERFLOW=20
ORACLE_POOL_RECYCLE=3600
ORACLE_POOL_PRE_PING=true

# ==================== SQLite 配置 ====================
SQLITE_DB_PATH=./data/sqlite
SQLITE_DB_NAME=app.db
SQLITE_POOL_SIZE=5
SQLITE_MAX_OVERFLOW=10
SQLITE_POOL_TIMEOUT=30
SQLITE_POOL_PRE_PING=true
SQLITE_CONNECT_TIMEOUT=30

# ==================== LDAP 认证配置 ====================
# 是否启用 LDAP 登录（true=生产环境调第三方接口，false=本地密码验证）
AUTH_USE_LDAP=false
# LDAP 第三方服务地址，例如 http://192.168.1.100:8080
LDAP_API_BASE=
# 注册时获取的服务名称
LDAP_SERVICE_NAME=
# 地区标识，例如 TW / CN
LDAP_LOCATION=TW

# ==================== 钉钉消息通知配置 ====================
# 第三方通知服务地址，例如 http://192.168.1.100:8080
DINGTALK_API_BASE=
# 注册时获取的服务名称、服务类型（RPA 或 Web）、token
DINGTALK_SERVICE_NAME=
DINGTALK_SERVICE_TYPE=Web
DINGTALK_TOKEN=
# 去重间隔（分钟），相同内容在此间隔内不重复推送
DINGTALK_SAME_ALARM_INTER=5

# ==================== 分库分表配置 ====================
# 分库开关（默认关闭）
SHARDING_DB_ENABLED=false
# 分表开关（默认关闭）
SHARDING_TABLE_ENABLED=false
# 分库日期格式：%Y%m%d(按天), %Y%m(按月), %Y(按年), %Y_w%W(按周)
SHARDING_DB_FORMAT=%Y%m%d
# 分表日期格式：%Y%m%d(按天), %Y%m(按月), %Y(按年), %Y_w%W(按周)
SHARDING_TABLE_FORMAT=%Y%m%d
# 分片策略：date, hash, range
SHARDING_STRATEGY=date
# 分库分表连接池配置
SHARDING_POOL_SIZE=10
SHARDING_MAX_OVERFLOW=20
SHARDING_POOL_RECYCLE=3600
SHARDING_POOL_TIMEOUT=30
SHARDING_POOL_PRE_PING=true
